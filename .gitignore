# ─────────────────────────────────────────────────────────────
# SynapX GymOS — root .gitignore
# ─────────────────────────────────────────────────────────────

# Secrets & environment files (keep only the *.example templates)
.env
.env.*
!.env.example
*.local

# Node
node_modules/
dist/
dist-ssr/
build/
.cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python (biometric service)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# Biometric runtime data (enrolled face vectors, member uploads)
face_index.json
uploads/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
