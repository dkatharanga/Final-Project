# SynapX Biometric Service — copy to .env and adjust as needed.

PORT=8000

# Face model (downloaded automatically on first run to ~/.insightface/models).
FACE_MODEL=buffalo_l

# Cosine-similarity cutoff for a face match (0-1). Higher = stricter.
# ~0.45 is a good start for buffalo_l; raise to 0.5+ to reduce false accepts.
FACE_THRESHOLD=0.45

# Where the enrolled-embedding gallery is persisted.
INDEX_PATH=face_index.json
