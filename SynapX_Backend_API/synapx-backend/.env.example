# ─────────────────────────────────────────
# SynapX GymOS — Environment Variables
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=synapx_gymos
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Secrets
JWT_SECRET=synapx_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=synapx_refresh_secret_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
KIOSK_URL=http://localhost:3001

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Optional: Stripe Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Optional: Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE=+1234567890

# Optional: SendGrid Email
SENDGRID_API_KEY=SG.your_sendgrid_key
FROM_EMAIL=noreply@synapx.io

# Biometric microservice (face + fingerprint). Blank = disabled.
BIOMETRIC_SERVICE_URL=http://localhost:8000
BIOMETRIC_TIMEOUT_MS=15000
